<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GRIDAutosportVR</RootNamespace>
    <AssemblyName>GRIDAutosportVR</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\logo.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">Experimental</ReleaseChannel>
    <BuildUtc Condition="'$(BuildUtc)' == ''">Development build</BuildUtc>
    <BuildRevision Condition="'$(BuildRevision)' == ''">local</BuildRevision>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" />
    <AssemblyMetadata Include="BuildUtc" Value="$(BuildUtc)" />
    <AssemblyMetadata Include="BuildRevision" Value="$(BuildRevision)" />
    <EmbeddedResource Include="assets\logo-display.png" LogicalName="GRIDAutosportVR.logo-display.png" />
    <EmbeddedResource Include="assets\logo.ico" LogicalName="GRIDAutosportVR.logo.ico" />
    <!-- Written by tools/build_cockpit_texture_pack.py; without it the cockpit texture option is hidden. -->
    <EmbeddedResource Include="assets\cockpit-texture-pack.json" LogicalName="GRIDAutosportVR.CockpitPack.json" Condition="Exists('assets\cockpit-texture-pack.json')" />
    <Content Condition="Exists('..\artifacts\probe\AutosportXRProbe.exe')" Include="..\artifacts\probe\AutosportXRProbe.exe" Link="probe\AutosportXRProbe.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Condition="Exists('..\artifacts\driving-input-build\Release\driving_input.dll')" Include="..\artifacts\driving-input-build\Release\driving_input.dll" Link="driving_input.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Condition="Exists('..\artifacts\bridge-build\Release\gasxr.dll')" Include="..\artifacts\bridge-build\Release\gasxr.dll" Link="renderer\gasxr.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
